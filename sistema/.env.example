# Ambiente local oficial
NODE_ENV=production
PORT=3001

# POSTGRES_PASSWORD: crua, inicializa o container do Postgres (não é URL).
# POSTGRES_PASSWORD_URLENC: a mesma senha com caracteres reservados de URL
# escapados (ex: @ -> %40) — o docker-compose.yml usa essa pra montar a
# DATABASE_URL do serviço api. Se a senha não tiver caractere especial, as
# duas ficam iguais. Ver "Armadilha: senha do Postgres..." no CLAUDE.md.
POSTGRES_PASSWORD=change-me-local
POSTGRES_PASSWORD_URLENC=change-me-local
DATABASE_URL=postgresql://postgres:change-me-local@db:5432/antenor_db?schema=public
REDIS_URL=redis://redis:6379
MEILI_HOST=http://meili:7700
MEILI_MASTER_KEY=change-me-local

JWT_SECRET=change-me-min-32-chars-local
CORS_ORIGIN=http://localhost:3000,http://localhost:3002,https://localhost:3443,https://localhost:3444
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

DEFAULT_TENANT_ID=tenant_default
DEFAULT_STORE_ID=store_default
ALLOW_DEFAULT_TENANT_CONTEXT=true
ALLOW_GUEST_CHECKOUT=true
ENABLE_LEGACY_CLASSIFICATION_MAPPINGS=false
HANDOFF_CSV_PATH=/data/handoff_ecommerce_v3_n1_n2.csv

ENABLE_PAYMENTS_INTEGRATION=false
INTEGRATION_PAYMENTS_ENABLED=false
PAYMENTS_PROVIDER_NAME=MANUAL
PAYMENTS_PROVIDER_URL=
PAYMENTS_API_KEY=
PAYMENTS_WEBHOOK_SECRET=
PIX_KEY=

SOLIDCOM_API_URL=
SOLIDCOM_API_KEY=
SOLIDCOM_CNPJ=
SOLIDCOM_CODECOM=
SOLIDCOM_BALCAO_CPF=

HUBSPOT_API_KEY=
HUBSPOT_PORTAL_ID=
HUBSPOT_DEFAULT_OWNER_ID=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@antenorefilhos.com.br

NFE_PROVIDER_NAME=
NFE_PROVIDER_URL=
NFE_API_KEY=
NFE_CERT_PATH=
NFE_CNPJ_EMITENTE=

VITE_API_URL=http://localhost:3001
VITE_GUEST_CHECKOUT_ENABLED=true
VITE_MAPBOX_ACCESS_TOKEN=
VITE_VAPID_PUBLIC_KEY=
VITE_CONTACT_WHATSAPP=
VITE_PAYMENTS_UI_ENABLED=false
ADMIN_PASSWORD=change-me-strong
QA_CUSTOMER_PASSWORD=change-me-qa

# ── Sync com o ERP Solidcom ─────────────────────────────────────────
# Incremental (GetProdutosAlterados): pega preco/promocao/produto novo.
# Roda de hora em hora e so grava quando o ERP acusa mudanca -- silencio
# no log nao quer dizer que parou.
ERP_SYNC_CRON_ENABLED=true
ERP_SYNC_INCREMENTAL_CRON=0 * * * *
ERP_SYNC_INCREMENTAL_HOURS=2
# Completo (catalogo inteiro, ~15,8 mil itens / ~190s). Varias vezes ao dia
# pra nao depender so do incremental pra manter preco e estoque em dia.
ERP_SYNC_CRON=0 4,11,16,20 * * *
