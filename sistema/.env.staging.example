# Homologacao local isolada
NODE_ENV=staging
PORT=3001

DATABASE_URL=postgresql://postgres:change-me-staging@db_staging:5432/antenor_staging?schema=public
REDIS_URL=redis://redis_staging:6379
MEILI_HOST=http://meili_staging:7700
MEILI_MASTER_KEY=change-me-staging

JWT_SECRET=change-me-min-32-chars-staging
CORS_ORIGIN=http://localhost:4000,http://localhost:4002
FRONTEND_URL=http://localhost:4000
ADMIN_URL=http://localhost:4002
WEB_PUSH_ORIGIN=http://localhost:4000

STAGING_CORS_ORIGIN=http://localhost:4000,http://localhost:4002
STAGING_FRONTEND_URL=http://localhost:4000
STAGING_ADMIN_URL=http://localhost:4002

DEFAULT_TENANT_ID=tenant_default
DEFAULT_STORE_ID=store_default
ALLOW_DEFAULT_TENANT_CONTEXT=false
ALLOW_GUEST_CHECKOUT=true
ENABLE_LEGACY_CLASSIFICATION_MAPPINGS=false

ENABLE_PAYMENTS_INTEGRATION=false
INTEGRATION_PAYMENTS_ENABLED=false
PAYMENTS_PROVIDER_NAME=MANUAL
PAYMENTS_PROVIDER_URL=
PAYMENTS_API_KEY=
PAYMENTS_WEBHOOK_SECRET=change-me-before-enabling-payment-gateway
PIX_KEY=

SOLIDCOM_API_URL=
SOLIDCOM_API_KEY=
SOLIDCOM_CNPJ=
SOLIDCOM_CODECOM=
SOLIDCOM_BALCAO_CPF=

HUBSPOT_API_KEY=
HUBSPOT_PORTAL_ID=
HUBSPOT_DEFAULT_OWNER_ID=

STAGING_VAPID_PUBLIC_KEY=
STAGING_VAPID_PRIVATE_KEY=
STAGING_VAPID_SUBJECT=mailto:admin@antenor.com.br

NFE_PROVIDER_NAME=
NFE_PROVIDER_URL=
NFE_API_KEY=
NFE_CERT_PATH=
NFE_CNPJ_EMITENTE=

VITE_API_URL=/api
VITE_GUEST_CHECKOUT_ENABLED=true
VITE_MAPBOX_ACCESS_TOKEN=
VITE_VAPID_PUBLIC_KEY=
VITE_CONTACT_WHATSAPP=
VITE_PAYMENTS_UI_ENABLED=false
