# Dependencies
node_modules/

# Build outputs
dist/
coverage/
artifacts/
*.log
sistema/frontend/stats.html

# JON-149 (Auditoria 360): certificado de dev/teste local -- so serve pra um
# server{} 443 dormente (Caddy fala so com a porta 80). Producao le de
# /etc/antenor-certs (fora do git, gerado direto na VPS), nunca daqui.
sistema/certs/*.pem

# External agent/tool state (nao faz parte do runtime do projeto)
.opencode/
.gemini/
.od-skills/
.github/skills/
.github/hooks/
.agents/
.browser-harness-v2/
.codex/
# `.claude/*` (com barra-asterisco), nao `.claude/`: com o diretorio inteiro
# ignorado o git nao desce nele e as excecoes abaixo nunca sao avaliadas.
.claude/*
# Excecao: a skill /salvar e' processo DESTE projeto (onde documentar, o que
# sincronizar no changelog do admin), nao configuracao de maquina — vale
# versionar pra nao viver so num computador. settings.json,
# settings.local.json, worktrees e skills de plugin seguem ignorados.
!.claude/skills/
.claude/skills/*
!.claude/skills/salvar/
# .github/workflows/ (CI) permanece versionado — so o tooling de agente e' ignorado

# Generated artifacts
graphify-out/
graphify-knowledge.json/
*/graphify-out/
.impeccable/

# Session histories and sensitive docs
arquivos-projeto/md/06\ -\ Sessões/Day_0_Historico.md

# Uploads de produto (runtime, servidos por volume Docker na VPS -- ver
# uploads_data em docker-compose.prod.yml -- nao por checkout de git; ~175MB
# e cresce a cada resync do ERP, so inchava o repo)
sistema/backend/uploads/products/

# Pasta uploads/ duplicada na raiz do projeto (achada em 10/10/2026, varredura
# de organizacao do repo) -- mesmo conteudo de sistema/backend/uploads/products/
# (fotos de produto por codigo numerico/EAN), ~420MB, visivelmente uma copia
# de trabalho fora do lugar certo. Mesma razao da regra acima: runtime, nao
# fonte de verdade de codigo.
/uploads/

