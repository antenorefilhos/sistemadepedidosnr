# URL da API (produção: https://api.antenorefilhos.com.br / dev local: http://localhost:3001)
NOTIFIER_API_URL=https://api.antenorefilhos.com.br

# Credenciais de login — use uma conta role=picker dedicada (menor privilégio,
# só precisa acessar /picker/orders), não a conta admin.
NOTIFIER_EMAIL=separador@antenorefilhos.com.br
NOTIFIER_PASSWORD=sua_senha_aqui

# --- Gatilho de faturamento do PDV (opcional) ---------------------------
# Sem estas quatro, o app segue avisando sobre separação normalmente; com
# elas, passa a liberar o pedido pro entregador quando o PDV fecha a venda.
#
# Roda aqui, e não na API, porque a VPS não tem rota para 10.13.0.2 — é a
# rede, não escolha de arquitetura.
#
# Use um usuário SQL SOMENTE LEITURA (precisa apenas de SELECT em tbPedido),
# nunca o `dash`: este agente roda num PC de loja.
DORSAL_DB_HOST=10.13.0.2
DORSAL_DB_PORT=1433
DORSAL_DB_NAME=DORSAL
DORSAL_DB_USER=usuario_somente_leitura
DORSAL_DB_PASSWORD=sua_senha_aqui
